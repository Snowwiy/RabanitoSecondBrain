# Publication allowlist: new root directories require an explicit review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ARCHITECTURE.md
!/CODING_MEMORY.md
!/DEPENDENCY_SECURITY.md
!/VENDOR_CONNECTORS.md
!/DESIGN.md
!/UX-CONTRACT.md
!/premium-ui.json
!/pyproject.toml
!/requirements.txt
!/rabanito/
!/tests/
!/web/
!/scripts/
!/docs/
!/config/
!/integrations/
!/.agents/
!/.claude/
!/.codex-plugin/
!/skills/

# Local configuration and private operational documentation stay on this PC.
/config/*
!/config/settings.example.json
!/config/security_catalog.json
/integrations/README.md
/integrations/patches/
/docs/local/

# Canonical private knowledge, derived indices, state and all backups.
/knowledge/
/data/
/runtime/
/exports/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql
*.dump
*.bak
*.log
*.tmp
*.temp
*.zip
*.7z
*.tar
*.gz

# Python, dependencies, test fixtures and operating-system artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage*
htmlcov/
node_modules/
dist/
build/
/tests/.test-temp/
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# Secrets: no exception for examples with real credential-like filenames.
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
*.keystore
*.kdbx
id_rsa*
id_ed25519*
credentials*
secrets*
token.json
tokens.json
auth.json
service-account*.json
.npmrc
.pypirc
.netrc
.vscode/
.idea/
